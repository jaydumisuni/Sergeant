{
  "name": "sergeant-reviewer",
  "displayName": "Sergeant",
  "description": "Model-free engineering review for VS Code. Optional model reasoning stays off until you enable it.",
  "version": "0.4.2",
  "publisher": "thetechguyds",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jaydumisuni/Sergeant.git"
  },
  "icon": "resources/srg-logo-and-icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/vscode/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sergeant",
          "title": "Sergeant",
          "icon": "resources/sergeant-activity.svg"
        }
      ]
    },
    "views": {
      "sergeant": [
        {
          "id": "sergeant.actions",
          "name": "Review"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "sergeant.actions",
        "contents": "Open Sergeant to review this workspace or inspect the last report."
      }
    ],
    "commands": [
      {
        "command": "sergeant.openCommandCenter",
        "title": "Sergeant: Open Review Center"
      },
      {
        "command": "sergeant.reviewWorkspace",
        "title": "Sergeant: Review Workspace"
      },
      {
        "command": "sergeant.appReviewWorkspace",
        "title": "Sergeant: App Bridge Review"
      },
      {
        "command": "sergeant.reviewCurrentFile",
        "title": "Sergeant: Review Current File"
      },
      {
        "command": "sergeant.reviewChangedFiles",
        "title": "Sergeant: Review Changed Files"
      },
      {
        "command": "sergeant.v2Mission",
        "title": "Sergeant: Build V2 Mission"
      },
      {
        "command": "sergeant.proofSuite",
        "title": "Sergeant: Run Proof Suite"
      },
      {
        "command": "sergeant.finalProof",
        "title": "Sergeant: Run Final Proof"
      },
      {
        "command": "sergeant.verifyStandard",
        "title": "Sergeant: Verify Standard"
      },
      {
        "command": "sergeant.battleTests",
        "title": "Sergeant: Validate Battle Tests"
      },
      {
        "command": "sergeant.ideBenchContract",
        "title": "Sergeant: IDE Bench Contract"
      },
      {
        "command": "sergeant.openLastReport",
        "title": "Sergeant: Open Last Report"
      },
      {
        "command": "sergeant.copyLastReport",
        "title": "Sergeant: Copy Last Report"
      },
      {
        "command": "sergeant.exportLastReport",
        "title": "Sergeant: Export Last Report"
      }
    ],
    "configuration": {
      "title": "Sergeant",
      "properties": {
        "sergeant.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Python executable used to run Sergeant."
        },
        "sergeant.llmPolicy": {
          "type": "string",
          "default": "disabled",
          "enum": [
            "disabled",
            "preferred",
            "required"
          ],
          "enumDescriptions": [
            "Standard model-free Sergeant review.",
            "Optional model reasoning with model-free fallback.",
            "Explicit model-assisted gate; fail when the selected route is unavailable."
          ],
          "description": "Advanced: optional model-reasoning policy. Disabled is the default."
        },
        "sergeant.llmProvider": {
          "type": "string",
          "default": "disabled",
          "enum": [
            "disabled",
            "auto",
            "cpl",
            "ollama",
            "lm-studio",
            "openai-compatible"
          ],
          "enumDescriptions": [
            "Do not discover or call models.",
            "Discover an explicitly enabled local route.",
            "Use the Cpl local gateway.",
            "Use Ollama.",
            "Use LM Studio.",
            "Use an explicitly configured OpenAI-compatible endpoint."
          ],
          "description": "Advanced: optional model engine beneath Cpl."
        },
        "sergeant.llmBaseUrl": {
          "type": "string",
          "default": "",
          "description": "Advanced: explicit optional model endpoint."
        },
        "sergeant.llmModel": {
          "type": "string",
          "default": "",
          "description": "Advanced: optional model slug."
        },
        "sergeant.llmProtocol": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "responses",
            "chat_completions"
          ],
          "description": "Advanced: optional model transport protocol."
        },
        "sergeant.llmCouncil": {
          "type": "string",
          "default": "adaptive",
          "enum": [
            "adaptive",
            "deep",
            "maximum",
            "single"
          ],
          "description": "Advanced: optional model reasoning depth."
        },
        "sergeant.cplMaxRounds": {
          "type": "integer",
          "default": 2,
          "minimum": 1,
          "maximum": 6,
          "description": "Advanced: maximum optional model rebrief rounds."
        },
        "sergeant.cplMaxCouncilMembers": {
          "type": "integer",
          "default": 5,
          "minimum": 1,
          "maximum": 12,
          "description": "Advanced: maximum optional model council members."
        }
      }
    }
  }
}
